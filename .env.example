NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
JUDGE_MODEL=
# Thinking is disabled, except for a reply the reasoning chain asks again. How to say so:
# thinking (GLM) or reasoning_effort (OpenAI-style, Ollama).
LLM_THINKING_PARAM=thinking
LLM_TIMEOUT=30
# Optional cumulative cap over eval/runs/usage_log.jsonl; leave empty for no cap.
TOKEN_BUDGET=
# Seconds to pause after each LLM call (1 suits the free GLM tier; 0 for paid providers).
LLM_COOLDOWN_S=1
SAFETY_REGION=US
QUERY_TIMEOUT_S=10
MAX_LIMIT=200
MAX_PATH_HOPS=2
# Optional cross-encoder that reorders fused text chunks (D115), e.g.
# Xenova/ms-marco-MiniLM-L-6-v2; empty keeps rank fusion only, the measured default.
RERANK_MODEL=
CACHE=false
CACHE_TTL_S=3600
MEDKG_PHASE=3
# chain (one tool at a time in one conversation, D127) or plan (one planning call, then the answer).
REASONING=chain
# The model's context window; the reasoning chain keeps its conversation inside it.
LLM_CONTEXT_TOKENS=12288
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=medical-kg-qa
PHOENIX_PROJECT_NAME=medical-kg-qa
