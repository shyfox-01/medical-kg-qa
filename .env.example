# 复制为 .env 后填写。.env 已被 .gitignore 排除，绝不要提交。
#
# ========== Neo4j ==========
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=在这里填你的密码
NEO4J_DATABASE=neo4j

# ========== LLM ==========
# 本项目只依赖 "OpenAI 兼容" 接口，换供应商 = 换下面三行，代码不用动。
#
# 【方案 A｜推荐，国内直连、有免费额度】智谱 GLM
#   注册 https://bigmodel.cn -> 右上角"API密钥"
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-flash
LLM_API_KEY=在这里填你的密钥

# 【方案 B｜硅基流动 SiliconFlow，注册送额度，模型多】
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_API_KEY=sk-xxx

# 【方案 C｜DeepSeek，便宜但不免费】
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxx

# 【方案 D｜Ollama 本地跑，完全离线免费，无需真实密钥】
#   ollama pull qwen3:8b
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama

# ========== 行为参数 ==========
MAX_CYPHER_RETRIES=3
DEFAULT_LIMIT=25
QUERY_TIMEOUT_S=10
TRACE=true

# 思维链开关：off / on / auto。GLM-4.5、Qwen3 这类混合推理模型默认会先想一大段。
# 默认 off，理由见 README 的实测对比。
LLM_THINKING=off

# ========== 行为开关（都能关掉，方便做 A/B 对照评测）==========
#   python -m eval.run_eval --no-fast-path --save eval/runs/llm_only.json
#   python -m eval.run_eval --baseline eval/runs/llm_only.json

# 模板快路径：意图明确且锚点唯一时，用白名单模板直接生成 Cypher，不调 LLM
FAST_PATH=true

# 医疗安全闸：急症提示、剂量拒答、特殊人群提醒、自伤危机干预
SAFETY=true

# 0 结果时用近似名 + 全文索引做兜底检索，而不是直接回一句"查不到"
FALLBACK_SEARCH=true

# 多轮对话记忆的轮数。0 = 关闭多轮（指代追问会失效）
HISTORY_TURNS=4

# 问答结果缓存（评测里默认关掉，否则重复轮次的方差恒为 0）
CACHE=true
CACHE_TTL_S=3600

# ---- 资源护栏 ----
# LIMIT 数值上限。模型写 LIMIT 100000 会被封顶到这个值
MAX_LIMIT=200
# 变长路径 [*a..b] 的最大跳数。33 万条关系上的无界遍历会打爆服务器
MAX_PATH_HOPS=3

# ========== 路径覆盖（可选）==========
# 默认会在仓库根目录、然后上一级目录里找。放在别处就用这两个变量指定。
# MEDICAL_JSON=D:\datasets\medical.json
# NEO4J_HOME=D:\neo4j\neo4j-community-5.26.0
