NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
JUDGE_MODEL=
LLM_THINKING=off
LLM_TIMEOUT=30
# Optional cumulative cap over eval/runs/usage_log.jsonl; leave empty for no cap.
TOKEN_BUDGET=
# Seconds to pause after each LLM call (1 suits the free GLM tier; 0 for paid providers).
LLM_COOLDOWN_S=1
SAFETY_REGION=US
QUERY_TIMEOUT_S=10
MAX_LIMIT=200
MAX_PATH_HOPS=2
CACHE=false
CACHE_TTL_S=3600
MEDKG_PHASE=3
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=medical-kg-qa
PHOENIX_PROJECT_NAME=medical-kg-qa
